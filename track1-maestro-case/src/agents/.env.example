OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# UiPath Automation Cloud
UIPATH_CLOUD_URL=https://cloud.uipath.com
UIPATH_ACCOUNT_NAME=your_account_name
UIPATH_TENANT_NAME=your_tenant_name
UIPATH_CLIENT_ID=your_client_id
UIPATH_CLIENT_SECRET=your_client_secret
UIPATH_ORGANIZATION_ID=your_org_id

# Application settings
ENV=development
LOG_LEVEL=INFO
PORT=8001
